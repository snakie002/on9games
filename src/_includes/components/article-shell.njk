{# Shared presentation for Snakie, Hfok and guest articles. Never alters body HTML. #}
{% set currentArticle = collections.posts | articleAtUrl(page.url) %}
{% set articleInfo = currentArticle | articleCard %}
{% set articleMeta = currentArticle | structuredMeta %}
<article class="article-layout">
  <header class="article-header">
    <div class="article-kickers">
      {% if articleInfo.contentType %}<a class="ct-badge" data-type="{{ articleInfo.contentType.id }}" href="{{ articleInfo.contentType.url }}">{{ articleInfo.contentType.label }}</a>{% endif %}
      {% if articleInfo.subject %}<a href="{{ articleInfo.subject.url }}">{{ articleInfo.subject.label }}</a>{% endif %}
      {% for franchise in articleMeta.franchises %}<a href="/franchise/{{ franchise }}/">{{ franchise | franchiseDisplay }}</a>{% endfor %}
    </div>
    <h1 class="article-title">{{ title }}</h1>
    {% if description %}<p class="article-deck">{{ description }}</p>{% endif %}
    <div class="article-byline">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
      {% if articleInfo.author %}<span aria-hidden="true">·</span><a href="{{ articleInfo.author.url }}">{{ articleInfo.author.label }}</a>{% endif %}
    </div>
    {% if tags %}<div class="article-tags" aria-label="標籤">
      {% for tag in tags | filterTagList %}<a href="/tags/{{ tag | tagPath }}/">{{ tag }}</a>{% endfor %}
    </div>{% endif %}
  </header>
  {% if articleInfo.cover %}<figure class="article-figure"><img class="article-cover" src="{{ articleInfo.cover }}" alt="{{ title }}" loading="eager" decoding="async"></figure>{% endif %}
  <div class="article-body post-content">{{ content | safe }}</div>
  {% set relatedItems = collections.posts | relatedArticles(currentArticle, 4) %}
  <section class="article-related" aria-labelledby="article-related-heading">
    <h2 id="article-related-heading">延伸閱讀</h2>
    <div class="card-grid">
      {% for post in relatedItems %}
        {% set cardVariant = "tile" %}
        {% include "./article-card.njk" %}
      {% endfor %}
    </div>
  </section>
</article>
