{# One listing for all six existing taxonomy routes. The cards use the Pass 1
   view-model; hubPosts is copied before sorting so collections aren't mutated. #}
{% include "./hub-header.njk" %}
<div class="hub-card-grid card-grid">
{% set orderedHubPosts = hubPosts | hubSort %}
{% for post in orderedHubPosts %}
  {% set cardVariant = "tile" %}
  {% include "./article-card.njk" %}
{% endfor %}
</div>
{% if not hubPosts.length %}<p class="hub-empty">這個分類暫時未有文章，敬請期待。</p>{% endif %}
<script defer src="/assets/js/hub-filters.js"></script>
