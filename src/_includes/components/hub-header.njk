{# Inputs: hubTitle, hubPosts, hubDescription (optional existing metadata only). #}
{% set hubTypeChips = hubPosts | hubTypes %}
<header class="hub-header">
  <div class="hub-heading">
    <h1>{{ hubTitle }}</h1>
    <span class="hub-count" aria-label="文章數量">{{ hubPosts.length }}</span>
  </div>
  {% if hubDescription %}<p class="hub-description">{{ hubDescription }}</p>{% endif %}
  {% if hubTypeChips.length > 1 %}
  <div class="hub-filters" role="group" aria-label="按內容類型篩選">
    <button class="hub-filter" data-filter="all" type="button" aria-pressed="true">全部</button>
    {% for type in hubTypeChips %}<button class="hub-filter" data-filter="{{ type.id }}" data-type="{{ type.id }}" type="button" aria-pressed="false">{{ type.label }}</button>{% endfor %}
  </div>
  {% endif %}
</header>
