---
permalink: /tags/
layout: layouts/home.njk
---

<h1>Tags</h1>
<ul>
    {% for tag in collections.all | getAllTags | filterTagList | sortByDateDesc %}
        {% set tagUrl = "/tags/" + (tag | tagPath) + "/" %}
        <li>
            <a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>
        </li>
    {% endfor %}
</ul>