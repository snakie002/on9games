---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    # Site machinery, never reader-facing tags. Any addCollection() that returns
    # an object (categories/games/franchises/topics/authors) MUST be listed here:
    # tags.njk paginates every collection key, and sortByDateDesc calls .sort(),
    # which throws on an object. Enforced by tests/tags-collection-denylist.test.js.
    - all
    - post
    - posts
    - tagList
    - recentPosts
    - featuredPosts
    - categories
    - games
    - franchises
    - topics
    - authors
    # Phase 2D structured-taxonomy collections. These return objects/arrays of
    # hub descriptors, not posts, and are rendered by game.njk / franchise.njk /
    # author.njk instead.
    - gameHubs
    - franchiseHubs
    - authorHubs
    - contentTypeHubs
    - unmappedLegacyTerms
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /tags/{{ tag }}/
---

{% set hubTitle = "標籤: " + tag %}
{% set hubPosts = collections[ tag ] %}
{% include "./_includes/components/hub-listing.njk" %}